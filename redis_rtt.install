<?php

/**
 * @file
 * Install and runtime requirement checks for the Redis RTT optimizer.
 */

declare(strict_types=1);

use Drupal\Core\Cache\Cache;
use Drupal\Core\Site\Settings;
use Drupal\redis\ClientFactory as RedisClientFactory;
use Drupal\redis_rtt\Client\PhpRedisRttFactory;
use Drupal\redis_rtt\Redis\Scripting;

/**
 * Returns php.ini's socket timeout, for reporting.
 *
 * @return string
 *   The value with its unit, e.g. "60s".
 */
function _redis_rtt_socket_timeout(): string {
  return ((string) ini_get('default_socket_timeout')) . 's';
}

/**
 * Returns where this module lives, relative to the docroot.
 *
 * Asked of the extension list first, because that is the only thing that knows
 * where Drupal found the module rather than where its files ended up. Deriving
 * it from __FILE__ looks equivalent and is not: PHP resolves symlinks, so with
 * the module symlinked into the docroot - which is what `composer require` on a
 * path repository does by default, and what ddev-drupal-contrib does - the
 * derived path points outside DRUPAL_ROOT and the advice falls back to a
 * hardcoded guess that names a directory which does not exist. Drupal then
 * ignores the container_yamls line without a word, drush cr still exits 0, and
 * the status row says "inactive" for ever.
 *
 * The derivation stays as the fallback, for hook_requirements() called from a
 * test or from install-time code where the service is not there.
 *
 * @return string
 *   The module path, e.g. "modules/contrib/redis_rtt".
 */
function _redis_rtt_module_path(): string {
  try {
    if (\Drupal::hasContainer() && \Drupal::hasService('extension.list.module')) {
      return \Drupal::service('extension.list.module')->getPath('redis_rtt');
    }
  }
  catch (\Throwable) {
    // Not installed, or the list cannot be built: fall through.
  }

  $dir = dirname(__FILE__);
  if (defined('DRUPAL_ROOT') && str_starts_with($dir, DRUPAL_ROOT . '/')) {
    return substr($dir, strlen(DRUPAL_ROOT) + 1);
  }

  // Last resort, and the one line here no test can reach: getting to it needs
  // either no DRUPAL_ROOT or the file outside it, and the suite always runs
  // with the module inside a docroot. It is a guess, and it is only ever used
  // where nothing better can be worked out.
  return 'modules/contrib/redis_rtt';
}

/**
 * Asks Redis whether it will run a script, with one that does nothing.
 *
 * \Drupal\redis_rtt\Redis\Scripting::wasRefused() only answers for scripts
 * this request happened to send, and the status page sends none: rendering it
 * invalidates no tag and takes no lock. So the row that exists to tell an
 * operator the module is degraded said nothing at all - measured against a
 * Redis with `rename-command EVAL ""`, where every invalidation on the site was
 * falling back silently and the report stayed green.
 *
 * The cost is one round trip, on a page nobody renders in a loop, and only when
 * a connection already exists for other reasons.
 *
 * @param \Drupal\redis\ClientInterface $client
 *   The connection to ask.
 *
 * @return bool
 *   TRUE if Redis refuses to run scripts.
 */
function _redis_rtt_scripting_refused($client): bool {
  try {
    Scripting::clearError($client);
    $reply = $client->eval('return 1', [], 0);
  }
  catch (\Throwable $e) {
    return Scripting::refuses($e);
  }

  // Only a recognised refusal. A script that failed for its own reason is not
  // this row's business, and saying so would be worse than saying nothing.
  return Scripting::refusedReply($client, $reply);
}

/**
 * Implements hook_requirements().
 *
 * Enabling this module changes nothing on its own: every optimisation is
 * switched on from settings.php. That is deliberate - the cache backend has to
 * be selectable before the container exists - but it means a site can sit with
 * the module enabled and none of it active, which is worth saying out loud on
 * the status report.
 *
 * Typed with @phpstan-return rather than @return: DrupalPractice objects to a
 * hook implementation restating the hook's documented signature, but PHPStan
 * still needs the array shape.
 *
 * @phpstan-return array<string, array<string, mixed>>
 */
function redis_rtt_requirements(string $phase): array {
  $requirements = [];

  // --- The redis module's major version ------------------------------------
  // Checked at install as well as at runtime, and as an error, because getting
  // this wrong is not a degraded site: every class in src/Cache extends one
  // that only exists in redis 2.x, so on 1.x the container cannot be built and
  // every page is a 500 with a class-not-found in the log, under php -S and
  // under nginx with PHP-FPM alike.
  //
  // It is easy to get wrong by accident. redis_rtt.info.yml can only say
  // "redis:redis" - Drupal compares "8.x-1.11" as greater than "2.0", so a
  // version constraint there does not hold - and composer.json asks for
  // "^2.0@alpha", which an ordinary `composer require drupal/redis` will not
  // give you, because 2.0.0-alpha2 is not stable and 1.11.0 is.
  //
  // So the class is asked for directly. That is the thing that actually has to
  // be true, and it stays true however the module arrived on disk.
  if (!class_exists('Drupal\redis\Cache\RedisBackend')) {
    $requirements['redis_rtt_redis_version'] = [
      'title' => t('Redis RTT: redis module version'),
      'value' => t('Incompatible'),
      'severity' => REQUIREMENT_ERROR,
      'description' => t('This module builds on the 2.x branch of the <a href="https://www.drupal.org/project/redis">redis</a> module and cannot run on 1.x: <code>Drupal\redis\Cache\RedisBackend</code> does not exist. Install it with <code>composer require "drupal/redis:^2.0@alpha"</code> - the version suffix is required, because 2.x has no stable release yet and Composer will otherwise resolve to 1.x.'),
    ];

    // Nothing below can be answered without those classes, and at install this
    // is the whole answer anyway.
    return $requirements;
  }

  if ($phase !== 'runtime') {
    return $requirements;
  }

  // --- The cache backend --------------------------------------------------
  // Asked of the bins themselves rather than of $settings['cache']['default'],
  // because a site may assign this backend per bin - the heavy ones only, which
  // is a perfectly ordinary thing to do - and reading the default key alone
  // would report a deliberate configuration as "not in use".
  $served = [];
  try {
    foreach (Cache::getBins() as $bin => $bin_backend) {
      if (is_a($bin_backend, 'Drupal\redis_rtt\Cache\PipeliningRedisBackend')) {
        $served[] = $bin;
      }
    }
  }
  catch (\Throwable $e) {
    // Listing the bins means instantiating every cache backend, and this hook
    // also runs where that cannot be done - mid-install, mid-rebuild, or with a
    // container that has not been given the bin list. Fall back to the setting
    // rather than taking the status report down with it.
    $served = (Settings::get('cache')['default'] ?? NULL) === 'cache.backend.redis_rtt'
      ? ['default']
      : [];
  }
  sort($served);
  $backend_active = (bool) $served;
  $default = Settings::get('cache')['default'] ?? NULL;
  $everywhere = $default === 'cache.backend.redis_rtt';

  if ($everywhere) {
    $value = t('Active');
  }
  elseif ($backend_active) {
    $value = t('Active on @count bins (@bins)', [
      '@count' => count($served),
      '@bins' => implode(', ', $served),
    ]);
  }
  else {
    $value = t('Not in use (current: @backend)', ['@backend' => $default ?? t('database')]);
  }

  $requirements['redis_rtt_backend'] = [
    'title' => t('Redis RTT: cache backend'),
    'value' => $value,
    'severity' => $backend_active ? REQUIREMENT_OK : REQUIREMENT_WARNING,
    'description' => $backend_active ? NULL : t(
      'This module\'s cache backend is where most of the saving comes from. Set <code>$settings["cache"]["default"] = "cache.backend.redis_rtt";</code> in settings.php, or assign it to individual bins through <code>$settings["cache"]["bins"]</code>.'
    ),
  ];

  // --- APCu ---------------------------------------------------------------
  $apcu = function_exists('apcu_fetch') && filter_var(ini_get('apc.enabled'), FILTER_VALIDATE_BOOL);
  $requirements['redis_rtt_apcu'] = [
    'title' => t('Redis RTT: APCu'),
    'value' => $apcu ? t('Available') : t('Not available'),
    'severity' => $apcu ? REQUIREMENT_OK : REQUIREMENT_WARNING,
    'description' => $apcu ? NULL : t(
      'Without APCu the render cache redirect shortcut and the cache tag warm set still behave correctly, but nothing they learn survives the request, so they save nothing. Install and enable the APCu extension.'
    ),
  ];

  // --- The service overrides ----------------------------------------------
  // Checked by asking the container what it actually built, rather than by
  // parsing settings: what matters is the wiring that ended up in effect.
  $overrides = [
    'variation_cache_factory' => [
      'class' => 'Drupal\redis_rtt\Cache\RedirectShortcutVariationCacheFactory',
      'label' => t('Render cache redirect shortcut'),
    ],
    'cache_tags.invalidator.checksum' => [
      'class' => 'Drupal\redis_rtt\Cache\PreloadingRedisCacheTagsChecksum',
      'label' => t('Cache tag checksums in one MGET'),
    ],
    'lock' => [
      'class' => 'Drupal\redis_rtt\Lock\LuaRedisLock',
      'label' => t('Single round-trip locks'),
    ],
  ];
  $missing = [];
  foreach ($overrides as $service_id => $info) {
    if (!\Drupal::hasService($service_id) || !is_a(\Drupal::service($service_id), $info['class'])) {
      $missing[] = $info['label'];
    }
  }
  $requirements['redis_rtt_services'] = [
    'title' => t('Redis RTT: service overrides'),
    'value' => $missing
      ? t('@count of @total inactive', ['@count' => count($missing), '@total' => count($overrides)])
      : t('All active'),
    'severity' => $missing ? REQUIREMENT_WARNING : REQUIREMENT_OK,
    // The path is asked for rather than written out. A hardcoded
    // modules/contrib/... is wrong wherever Composer or a hand install put the
    // module somewhere else, and Drupal ignores a container_yamls entry that
    // does not exist without saying anything: the advice then does nothing,
    // drush cr still exits 0, and this row goes on saying "inactive" for ever.
    // @see _redis_rtt_module_path()
    'description' => $missing ? t(
      'Inactive: @list. Add the module\'s service overrides to settings.php: <code>$settings["container_yamls"][] = "@path/redis_rtt.services.example.yml";</code>',
      [
        '@list' => implode(', ', $missing),
        '@path' => _redis_rtt_module_path(),
      ]
    ) : NULL,
  ];

  // --- The connection -----------------------------------------------------
  // Reported from the connection that exists, not from the setting that asks
  // for one: the two are different questions, and the setting is the weaker of
  // the two. It is absent on any site that lets service priority choose - with
  // no 'interface' named, \Drupal\redis\ClientFactory takes the
  // highest-priority tagged factory, which is the redis module's own 20 against
  // this module's deliberate 10 - and where it is present it names a factory
  // rather than what came out of it: instrumentation wraps the client and
  // changes its name without changing what it is. The client knows which one it
  // is, which is what \Drupal\redis_rtt\Client\PhpRedisRtt::getName() exists
  // for, so ask it.
  $connection = Settings::get('redis.connection', []);
  $persistent = !empty($connection['persistent']);
  $interface = $connection['interface'] ?? NULL;
  $factory = \Drupal::hasService('redis.factory') ? \Drupal::service('redis.factory') : NULL;
  // ::hasClient() and never ::getClient(): asking for a connection here would
  // open one this request had no other need for, and a check that makes itself
  // true is not a check. No client means nothing has needed Redis yet, and a
  // named 'interface' then still settles it - ClientFactory throws on a name it
  // does not know, and a site serving this page at all got past that - while an
  // unnamed one leaves the choice to service priority, which cannot be read
  // back from here.
  $client = $factory instanceof RedisClientFactory && $factory->hasClient()
    ? $factory->getClientName()
    : $interface;
  $connection_notes = [];
  // Notes that describe a problem drive the severity. Notes that merely state
  // what is in force do not: reporting a correctly configured timeout as
  // "suboptimal" trains people to ignore the row.
  $connection_info = [];
  if (!$persistent) {
    $connection_notes[] = t('Persistent connections are off. Every request pays a fresh TCP (and TLS) handshake, which is several round trips before any work happens.');
  }
  if ($client === NULL) {
    $connection_notes[] = t('No Redis connection has been made yet this request and no <code>interface</code> is named, so which client is in force cannot be reported from here - it is whichever tagged factory has the highest priority, and that depends on what else is installed. Name it to settle the question: <code>$settings["redis.connection"]["interface"] = "PhpRedisRtt";</code>');
  }
  if ($client !== NULL && str_starts_with(strtolower($client), 'predis')) {
    $connection_notes[] = t('The client is Predis, whose <code>eval()</code> takes its arguments in a different order from phpredis. This module therefore does not send it any Lua, and the two optimisations that depend on scripting - single round-trip cache invalidation and single round-trip lock release - fall back to the same commands the redis module would send. Everything still works; those two savings do not apply. Switch to phpredis to get them.');
  }
  // A Redis that will not run Lua degrades this module instead of breaking it,
  // and from outside a degraded site looks exactly like a healthy one: 200s all
  // round, nothing in the log, two savings quietly gone. This row is the only
  // place it shows.
  //
  // Asked rather than remembered. The flag does not outlive a request and this
  // page sends no script of its own, so reading the flag alone reported on the
  // status page and nothing else: against a Redis with EVAL renamed, the row
  // stayed green while every invalidation on the site fell back.
  // @see _redis_rtt_scripting_refused()
  $refused = Scripting::wasRefused();
  if (!$refused && $factory instanceof RedisClientFactory && $factory->hasClient()) {
    $connection_client = $factory->getClient();
    $refused = !Scripting::unavailable($connection_client)
      && _redis_rtt_scripting_refused($connection_client);
  }
  if ($refused) {
    $connection_notes[] = t('Redis refuses to run Lua scripts, so the two optimisations that depend on scripting - single round-trip cache invalidation and single round-trip lock release - fall back to the same commands the redis module would send. The site works; those two savings do not apply. This usually means scripting is out of the ACL, or <code>EVAL</code> has been renamed.');
  }
  if ($client !== NULL && !str_starts_with($client, 'PhpRedisRtt')) {
    $connection_notes[] = t('The connection is @client rather than PhpRedisRtt, so this module configures no read timeout and phpredis falls back to the <code>default_socket_timeout</code> of php.ini, currently @stock. A connection dropped by a failover then holds its PHP worker for that long - twice that, in fact, for a request that opens a second connection after the first one fails.', [
      '@client' => $client,
      '@stock' => _redis_rtt_socket_timeout(),
    ]);
  }
  // The read timeout is the module's most consequential connection setting and
  // the one nobody thinks about until a failover. Report the number, not just
  // that there is one - and read it from the same place the connection does,
  // so this cannot describe a timeout that is not in force.
  if ($client !== NULL && str_starts_with($client, 'PhpRedisRtt')) {
    $resolved = PhpRedisRttFactory::resolveReadTimeout($connection);
    switch ($resolved['state']) {
      case 'invalid':
        // A note, not an info: this one describes a problem, so it drives the
        // severity. A mistyped value used to pass through a (float) cast as 0,
        // which meant "no limit", and the row said it was deliberate.
        $connection_notes[] = t('<code>$settings["redis.connection"]["read_timeout"]</code> is set to <code>@raw</code>, which is not a number. It has been refused and the default of @seconds s is in force. A decimal comma, an empty string, and a <code>getenv()</code> for a variable that is not set all land here.', [
          '@raw' => is_scalar($resolved['raw']) ? var_export($resolved['raw'], TRUE) : gettype($resolved['raw']),
          '@seconds' => $resolved['timeout'],
        ]);
        break;

      case 'stock':
        $connection_info[] = t('Reads are bounded exactly as they would be without this module: <code>$settings["redis.connection"]["read_timeout"]</code> is 0 or less, so what is imposed on the connection is php.ini\'s <code>default_socket_timeout</code>, currently @stock - the same bound a site without this module would have. Note that a value of 0 there means reads expire immediately, and a negative one means never. Set a positive <code>read_timeout</code> to bound reads regardless of php.ini.', [
          '@stock' => _redis_rtt_socket_timeout(),
        ]);
        break;

      default:
        $connection_info[] = t('Reads give up after @seconds s. That bounds a stalled Redis to one failed request instead of a blocked worker; without it a connection dropped by a failover holds the worker for php.ini\'s <code>default_socket_timeout</code>, currently @stock. The trade is that a Redis slower than this answers with an error page rather than a slow page. Set <code>$settings["redis.connection"]["read_timeout"]</code> to change it, or to 0 for the stock behaviour. Read the number from php.ini rather than assuming the 60 s of a stock install: on a host that lowers it, this module is the slower of the two.', [
          '@seconds' => $resolved['timeout'],
          '@stock' => _redis_rtt_socket_timeout(),
        ]);
    }
  }

  $requirements['redis_rtt_connection'] = [
    'title' => t('Redis RTT: Redis connection'),
    'value' => match (TRUE) {
      $client === NULL => t('Unknown'),
      (bool) $connection_notes => t('Suboptimal (@client)', ['@client' => $client]),
      default => t('Configured (@client)', ['@client' => $client]),
    },
    'severity' => $connection_notes ? REQUIREMENT_WARNING : REQUIREMENT_OK,
    'description' => ($connection_notes || $connection_info) ? [
      '#theme' => 'item_list',
      '#items' => array_merge($connection_notes, $connection_info),
    ] : NULL,
  ];

  // --- Instrumentation ----------------------------------------------------
  // A warning rather than a note: leaving it on fleet-wide keeps every query of
  // every request in memory.
  if (Settings::get('redis_rtt_report', FALSE)) {
    $requirements['redis_rtt_report'] = [
      'title' => t('Redis RTT: round-trip reporting'),
      'value' => t('Enabled'),
      'severity' => REQUIREMENT_WARNING,
      'description' => t('The X-Redis-RTT response header is being emitted and the database query log is being kept in memory for every request. Intended for a canary task or a load test, not for the whole fleet. Unset <code>$settings["redis_rtt_report"]</code> when finished measuring.'),
    ];
  }

  return $requirements;
}
