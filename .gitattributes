# Keep development-only files out of the packaged release. Drupal.org packages
# with git-archive, which honours this; a git clone still gets everything.
#
# Nothing needed at runtime belongs here: the .services.example.yml is loaded
# from settings.php on a real site, so it ships.
#
# /tests is deliberately NOT here. A module whose whole argument is "measure,
# do not assert" has to let the person who installed it run the measurements,
# and a release tarball without tests cannot be checked by anyone who did not
# clone the repository.
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.gitlab-ci.yml     export-ignore
/phpcs.xml.dist     export-ignore
/phpstan.neon.dist  export-ignore
